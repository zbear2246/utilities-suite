#!/bin/sh

set -eu

SCRIPT_PATH=$(command -v "$0")
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)

. "$SCRIPT_DIR/common"

build_project

# ----------------------------------------
# Git
# ----------------------------------------

info "=== Checking Git changes ==="

git add .

if git diff --cached --quiet; then
    warning "No changes to commit."
    exit 0
fi

printf 'Commit Summary: '
IFS= read -r summary

printf 'Commit Message: '
IFS= read -r message

if [ -z "$summary" ]; then
    error "Commit summary cannot be empty."
fi

if [ -z "$message" ]; then
    git commit -m "$summary"
else
    git commit -m "$summary" -m "$message"
fi

# ----------------------------------------
# Push
# ----------------------------------------

info "=== Pushing ==="

git push

success "Done!"
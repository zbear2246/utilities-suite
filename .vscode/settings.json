{
    "chat.disableAIFeatures": true,
    "explorer.compactFolders": false,
    "files.exclude": {
        "**/.git": true,
        "**/.gradle": true,
        "**/build": true,
        "**/bin": true,
        "**/*.class": true,
        "**/*.jar": true,
        "**/.DS_Store": true
    },
    "search.exclude": {
        "**/.git": true,
        "**/.gradle": true,
        "**/build": true,
        "**/bin": true
    },
    "files.watcherExclude": {
        "**/.git/**": true,
        "**/.gradle/**": true,
        "**/build/**": true,
        "**/bin/**": true
    }
}
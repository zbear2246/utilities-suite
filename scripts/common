#!/bin/sh

BLUE='\033[1;34m'
GREEN='\033[1;32m'
RED='\033[1;31m'
YELLOW='\033[1;33m'
RESET='\033[0m'

error() {
    printf '%sERROR: %s%s\n' "$RED" "$1" "$RESET"
    exit 1
}

info() {
    printf '%s%s%s\n' "$BLUE" "$1" "$RESET"
}

success() {
    printf '%s%s%s\n' "$GREEN" "$1" "$RESET"
}

warning() {
    printf '%s%s%s\n' "$YELLOW" "$1" "$RESET"
}

require_project_root() {
    if [ ! -f "./gradlew" ]; then
        error "gradlew not found. Run this command from the project root."
    fi
}

build_project() {
    require_project_root

    info "=== Building project ==="

    if [ -n "${ANDROID_HOME:-}" ] && [ -d "$ANDROID_HOME" ]; then
        success "Android SDK found — deploying"
        ./gradlew deploy
    else
        warning "Android SDK not found — building JAR"
        ./gradlew jar
    fi
}